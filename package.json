{
  "name": "calculadora-analisis-numerico",
  "version": "1.0.0",
  "description": "Calculadora de Análisis Numérico con empaquetado para escritorio",
  "main": "electron/main.js",
  "homepage": "https://github.com/tu-usuario/calculadora-analisis-numerico",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "build-mac": "electron-builder --mac",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "serve": "python3 -m http.server 38141 --bind 127.0.0.1"
  },
  "keywords": [
    "analisis-numerico",
    "electron",
    "math",
    "integration",
    "interpolation",
    "scientific-calculator"
  ],
  "author": "Jesús Manuel Manrique Rativa & Cristian Villanueva Medina",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.calculadoraanalisisnumerico.app",
    "productName": "Calculadora de Análisis Numérico",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "favicon.svg",
      "css/**/*",
      "js/**/*",
      "modules/**/*",
      "electron/**/*",
      "package.json",
      "README.md"
    ],
    "extraFiles": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": []
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
